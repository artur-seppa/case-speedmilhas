{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Sem isto o TypeScript infere o common root a partir de prisma.config.ts (que fica
    // na raiz do api/) e o build sai em dist/src/main.js, quebrando o `start:prod`.
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "dist", "test", "prisma.config.ts", "**/*spec.ts"]
}
