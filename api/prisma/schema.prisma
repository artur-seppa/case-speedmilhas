// Modelar o banco é parte do desafio — por isso este arquivo só tem a
// configuração, sem nenhum model. Pense no que você precisa persistir.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id             String   @id @default(ulid())
  quoteId        String
  supplier       String
  carrier        String
  miles          Int
  taxesBrl       Float
  passengerName  String
  passengerCpf   String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
}
