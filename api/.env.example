# Copie para api/.env antes de rodar:  cp api/.env.example api/.env
#
# Os valores abaixo já casam com o docker-compose.yml padrão. Se você mudou
# POSTGRES_PORT ou MOCK_SUPPLIERS_PORT no .env da raiz, ajuste aqui também.

DATABASE_URL="postgresql://speedmilhas:speedmilhas@localhost:5432/speedmilhas?schema=public"

# Base dos três fornecedores mock (sobem no docker-compose).
SUPPLIERS_BASE_URL=http://localhost:4000

# Porta da API. Suba uma segunda instância com PORT=3010 para testar o RF2.
PORT=3000
