# Configuração do docker-compose (banco + fornecedores mock).
# Copie para .env antes de subir:  cp .env.example .env
#
# Nenhum destes valores é segredo. É ambiente de desafio, roda só na sua máquina.

POSTGRES_USER=speedmilhas
POSTGRES_PASSWORD=speedmilhas
POSTGRES_DB=speedmilhas

# Portas expostas no host. Só mude se já tiver algo ocupando estas portas.
POSTGRES_PORT=5432
MOCK_SUPPLIERS_PORT=4000
